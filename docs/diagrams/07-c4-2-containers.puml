@startuml
title FestaLink — C4-2 Containers

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName "Helvetica"
skinparam rectangle {
  BackgroundColor #F5F7FB
  BorderColor #4B5563
  FontColor #111827
}
skinparam database {
  BackgroundColor #F5F7FB
  BorderColor #4B5563
  FontColor #111827
}
skinparam cloud {
  BackgroundColor #FFFFFF
  BorderColor #9CA3AF
  FontColor #374151
}
skinparam package {
  BackgroundColor #FAFBFD
  BorderColor #9CA3AF
  FontColor #374151
}
skinparam note {
  BackgroundColor #FFF7E6
  BorderColor #B58900
}

actor "Cliente" as cli
actor "Prestador" as pres

package "FestaLink (sistema)" {
  rectangle "App Cliente\n[Container: Flutter]\nMobile Android" as appCli
  rectangle "App Prestador\n[Container: Flutter]\nMobile Android" as appPres
  rectangle "API\n[Container: Node.js + Express :3000]\nREST somente\n(publisher de eventos)" as api
  rectangle "Worker\n[Container: Node.js :3001]\nConsumer + WebSocket\n(sem rotas HTTP)" as worker
  database "SQLite\n[Container: arquivo local]\nUsuários, salões, horários,\nbloqueios, reservas, avaliações" as db
}

cloud "RabbitMQ\n[Sistema externo — :5672]\nMOM (exchange topic durável\n+ fila durável)" as rabbit

cli --> appCli : usa
pres --> appPres : usa

appCli --> api : HTTPS / REST\n(JSON, JWT)
appPres --> api : HTTPS / REST\n(JSON, JWT)
appPres <--> worker : WebSocket\n(conexão persistente\npara eventos)

api --> db : SQL\n(lib SQLite no Node)
worker --> db : SQL\n(leitura de salões\npara roteamento)
api --> rabbit : publica eventos\nReservaSolicitada/Aprovada/Recusada\n(AMQP, persistent)
worker <-- rabbit : consome eventos\n(AMQP, ack manual,\nfila durável)

note as N1
  Três processos independentes. A API só publica.
  O worker só consome e empurra pelo WebSocket.
  RabbitMQ é o ponto de desacoplamento — se o
  worker cai, mensagens acumulam na fila e são
  entregues quando ele volta. API segue operando
  normalmente independentemente do estado do worker.
end note

@enduml
