@startuml
title FestaLink — Arquitetura Consolidada

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName "Helvetica"
skinparam rectangle {
  BackgroundColor #F5F7FB
  BorderColor #4B5563
  FontColor #111827
}
skinparam database {
  BackgroundColor #F5F7FB
  BorderColor #4B5563
  FontColor #111827
}
skinparam cloud {
  BackgroundColor #FFFFFF
  BorderColor #9CA3AF
  FontColor #374151
}
skinparam package {
  BackgroundColor #FAFBFD
  BorderColor #9CA3AF
  FontColor #374151
}
skinparam note {
  BackgroundColor #FFF7E6
  BorderColor #B58900
}

actor "Cliente" as cli
actor "Prestador" as pres

package "Mobile (Flutter)" as mob {
  rectangle "App Cliente\n[Flutter / Android]\nbusca de salões,\nsolicita reservas,\npolling de status" as appCli
  rectangle "App Prestador\n[Flutter / Android]\naprova/recusa pedidos,\nresponde avaliações,\nrecebe push via WS" as appPres
}

package "API (Node.js + Express — processo :3000)" as api {

  package "L1 — Frameworks & Drivers (API)" as L1A {
    rectangle "Express Routes\n+ JWT middleware" as routes
    rectangle "amqplib (producer)" as amqpP
    rectangle "better-sqlite3\n(driver)" as dbinit
  }

  package "L2 — Adapters (API)" as L2A {
    rectangle "HTTP Controllers" as ctrl
    rectangle "Repositórios SQL" as repo
    rectangle "Event Publisher" as pub
  }

  package "L3 — Use Cases / Application" as L3 {
    rectangle "Use Cases\nConta · Salão · Disponibilidade\nReserva · Avaliação" as uc
    rectangle "Ports (interfaces)\nIUsuarioRepo · ISalaoRepo\nIReservaRepo · IAvaliacaoRepo\nIEventPublisher · IPrestadorNotifier" as ports
  }

  package "L4 — Domínio" as L4 {
    rectangle "Entidades\nUsuario · Salao\nHorarioFuncionamento · BloqueioData\nReserva · Avaliacao" as ent
    rectangle "Eventos de Domínio\nReservaSolicitada\nReservaAprovada\nReservaRecusada" as evs
  }
}

package "Worker (Node.js — processo :3001)" as worker {

  package "L1 — Frameworks & Drivers (Worker)" as L1W {
    rectangle "amqplib (consumer)" as amqpC
    rectangle "WebSocket Server\n(lib ws)" as wssetup
  }

  package "L2 — Adapters (Worker)" as L2W {
    rectangle "Event Consumer" as cons
    rectangle "WS Notifier" as wsn
  }
}

database "SQLite\n[arquivo local]\nusuários, salões, horários,\nbloqueios, reservas, avaliações" as db

cloud "RabbitMQ\n[Sistema externo — :5672]\nMOM (exchange topic durável\n+ fila durável)" as rabbit

cli --> appCli : usa
pres --> appPres : usa

appCli --> routes : HTTPS / REST\n(JSON, JWT)\n+ polling de status
appPres --> routes : HTTPS / REST\n(JSON, JWT)
appPres <--> wssetup : WebSocket\n(conexão persistente)

routes --> ctrl
wssetup --> wsn
amqpP --> pub
amqpC --> cons
dbinit --> repo

ctrl --> uc

repo ..|> ports : implementa
pub ..|> ports : implementa
wsn ..|> ports : implementa

uc --> ports
uc --> ent
uc ..> evs
evs ..> ent

repo --> db : SQL
pub --> rabbit : publish (persistent)\nReservaSolicitada/Aprovada/Recusada
cons <-- rabbit : consume + ack manual\n(fila durável)
cons --> wsn : entrega evento\npara o prestador

note right of api
  Regra de dependência (Clean Architecture):
  as setas internas apontam sempre de fora
  para dentro — L1 → L2 → L3 → L4. O domínio
  (L4) não importa nada de framework.
end note

note bottom of worker
  Fluxo event-driven (item 2.2 do enunciado):
  Use Case na API muda o status da reserva →
  publica evento via IEventPublisher → RabbitMQ
  persiste em fila durável → Worker consome com
  ACK manual → WS Notifier empurra para o app
  prestador conectado. O app cliente reflete a
  mudança via polling REST.

  Durabilidade: se o worker cai, mensagens
  acumulam na fila e são entregues quando ele
  reconecta.
end note

@enduml
