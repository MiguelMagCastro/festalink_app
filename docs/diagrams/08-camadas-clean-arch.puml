@startuml
title FestaLink — Camadas do Backend (Clean Architecture)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName "Helvetica"
skinparam rectangle {
  BackgroundColor #F5F7FB
  BorderColor #4B5563
  FontColor #111827
}
skinparam package {
  BackgroundColor #FAFBFD
  BorderColor #9CA3AF
  FontColor #374151
}
skinparam note {
  BackgroundColor #FFF7E6
  BorderColor #B58900
}

package "L1 — Frameworks e Drivers" as L1 {
  rectangle "Routes\n(Express — só na API)" as routes
  rectangle "WebSocket setup\n(lib ws — só no Worker)" as wssetup
  rectangle "amqplib\n(producer na API,\nconsumer no Worker)" as amqp
  rectangle "DB init\n(better-sqlite3)" as dbinit
}

package "L2 — Adapters" as L2 {
  rectangle "HTTP Controllers" as ctrl
  rectangle "Repositórios SQL" as repo
  rectangle "Event Publisher\n(API)" as pub
  rectangle "Event Consumer\n(Worker)" as cons
  rectangle "WS Notifier\n(Worker)" as wsn
}

package "L3 — Use Cases / Application" as L3 {
  rectangle "Use Cases\nConta, Salão,\nDisponibilidade,\nReserva, Avaliação" as uc
  rectangle "Ports (interfaces)\nIUsuarioRepo, ISalaoRepo,\nIReservaRepo, IAvaliacaoRepo,\nIEventPublisher,\nIPrestadorNotifier" as ports
}

package "L4 — Domínio (Entities)" as L4 {
  rectangle "Entidades\nUsuario, Salao,\nHorarioFuncionamento,\nBloqueioData, Reserva,\nAvaliacao" as ent
  rectangle "Eventos de Domínio\nReservaSolicitada,\nReservaAprovada,\nReservaRecusada" as evs
}

routes --> ctrl
wssetup --> wsn
amqp --> pub
amqp --> cons
dbinit --> repo

ctrl --> uc

repo ..|> ports : implementa
pub ..|> ports : implementa
wsn ..|> ports : implementa

cons --> wsn : entrega evento\nao notifier

uc --> ports
uc --> ent
uc ..> evs
evs ..> ent

note as N1
  As setas representam dependência e apontam
  sempre de fora para dentro. As camadas
  internas não importam nada das externas.

  O backend é dividido em dois processos
  independentes que compartilham as camadas
  L3 e L4. A API instancia Publisher; o
  Worker instancia Consumer + WS Notifier.
  A composição mora em src/composition.js
  via comporApi() e comporWorker().

  As Ports (interfaces) ficam na camada de
  Use Cases e são implementadas pelos
  Adapters da camada externa via injeção
  de dependência no boot de cada processo.
end note

@enduml
